{
  "name": "leya-nails",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=server --watch-path=schema.sql server/node.js",
    "start": "node server/node.js",
    "cf:db:create": "wrangler d1 create leya-nails",
    "cf:db:init": "wrangler d1 execute leya-nails --remote --file=schema.sql",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "wrangler": "^4.164.0"
  }
}
